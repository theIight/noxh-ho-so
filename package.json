{
  "name": "noxh-ho-so",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SPA tạo bộ hồ sơ đăng ký mua nhà ở xã hội. Không backend, dữ liệu chỉ ở trong trình duyệt.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify-templates": "tsx scripts/verify-templates.ts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.5",
    "docxtemplater": "3.71.1",
    "file-saver": "2.0.5",
    "jszip": "3.10.2",
    "pizzip": "3.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-router": "8.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/file-saver": "2.0.7",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "docx": "9.15.3",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
